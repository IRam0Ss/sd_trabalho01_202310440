<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1000" prefHeight="650"
    xmlns="http://javafx.com/javafx/8"
    xmlns:fx="http://javafx.com/fxml/1">

    <!-- ===================== PAINEL ESQUERDO ===================== -->
    <left>
        <VBox prefWidth="270"
              style="-fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;">

            <Label text="Conversas"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 8 8 8; -fx-text-fill: #128C7E;"/>

            <!-- Lista unificada de grupos e conversas privadas -->
            <ListView fx:id="listaGrupos" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent;"/>

            <Separator/>

            <VBox spacing="5" style="-fx-padding: 8;">
                <Label text="Entrar em Grupo:"
                       style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                <TextField fx:id="campoEntrarGrupo"
                           promptText="Nome do grupo..."
                           onAction="#handleEntrarGrupo"/>
                <HBox spacing="5" maxWidth="Infinity">
                    <Button fx:id="botaoEntrar" text="Entrar"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            onAction="#handleEntrarGrupo"
                            style="-fx-background-color: #128C7E; -fx-text-fill: white;"/>
                    <Button fx:id="botaoSair" text="Sair"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            onAction="#handleSairGrupo"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                </HBox>

                <Button fx:id="botaoListarGrupos" text="Grupos Existentes"
                        maxWidth="Infinity" onAction="#handleListarGrupos"/>

                <Separator/>

                <Button fx:id="botaoChatPrivado" text="Novo Chat Privado"
                        maxWidth="Infinity" onAction="#handleChatPrivado"
                        style="-fx-background-color: #25D366; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ===================== AREA CENTRAL (CHAT) ===================== -->
    <center>
        <BorderPane style="-fx-background-color: #ECE5DD;">

            <!-- Header do chat -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 8 12; -fx-background-color: #128C7E;">
                    <Button fx:id="botaoVerMembros" text="Chat"
                            onAction="#handleVerMembros"
                            style="-fx-background-color: transparent; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 15px; -fx-border-color: transparent;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="botaoBloquear" text="Bloquear"
                            onAction="#handleBloquear"
                            disable="true"
                            style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 11px;"/>
                </HBox>
            </top>

            <!-- Area de mensagens -->
            <center>
                <ListView fx:id="areaChat"
                          style="-fx-background-color: #ECE5DD; -fx-border-color: transparent;"/>
            </center>

            <!-- Barra de envio -->
            <bottom>
                <VBox style="-fx-background-color: #f0f0f0; -fx-padding: 6 10;">

                    <!-- Indicador de modo VU ativo -->
                    <Label fx:id="labelStatusVU"
                           text="[VU] Modo Visualizacao Unica ATIVO - proxima mensagem some apos lida"
                           visible="false"
                           style="-fx-text-fill: #ff6b35; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 2 0 4 0;"/>

                    <!-- Campo de texto + botoes -->
                    <HBox spacing="6" alignment="CENTER_LEFT">

                        <!-- Botao de Visualizacao Unica -->
                        <Button fx:id="botaoVisualizacaoUnica" text="VU"
                                onAction="#handleVisualizacaoUnica"
                                disable="true"
                                prefWidth="36"
                                style="-fx-font-size: 12px; -fx-font-weight: bold;"/>

                        <TextField fx:id="campoMensagem"
                                   disable="true"
                                   promptText="Digite uma mensagem..."
                                   HBox.hgrow="ALWAYS"
                                   onAction="#handleEnviarMensagem"/>

                        <Button fx:id="botaoEnviar" text="Enviar"
                                disable="true"
                                onAction="#handleEnviarMensagem"
                                style="-fx-background-color: #128C7E; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
